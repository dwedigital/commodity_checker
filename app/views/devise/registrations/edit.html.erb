<%= render "shared/page_header", eyebrow: "YOUR ACCOUNT", title: "Account settings", description: "Keep your details up to date and your account secure." %>
<div class="tf-settings-layout">
  <aside class="tf-settings-aside">
    <span class="tf-account-avatar" aria-hidden="true"><%= resource.email.first.upcase %></span>
    <h2>Your Tariffik account</h2>
    <p class="tf-settings-email"><%= resource.email %></p>
    <span class="tf-badge tf-badge-neutral"><%= resource.subscription_tier.titleize %> plan</span>
    <p class="mt-6">Your saved lookups and orders stay with your account when you update your details.</p>
    <%= link_to "Back to your dashboard →", dashboard_path, class: "tf-text-link" %>
  </aside>
  <div>
    <div class="tf-panel">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "tf-settings-form" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <fieldset>
          <legend>Email address</legend>
          <div class="tf-field">
            <%= f.label :email, "Your email" %>
            <%= f.email_field :email, autocomplete: "email" %>
            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %><p>Waiting for confirmation of: <%= resource.unconfirmed_email %></p><% end %>
          </div>
        </fieldset>
        <fieldset>
          <legend>Change password</legend>
          <div class="tf-field" data-controller="password-strength">
            <%= f.label :password, "New password" %>
            <%= f.password_field :password, autocomplete: "new-password", aria: { describedby: "password-help" }, data: { password_strength_target: "input", action: "input->password-strength#validate" } %>
            <p id="password-help">Leave blank to keep your current password.</p>
            <div class="tf-password-guidance">
              <p>Your new password needs:</p>
              <ul>
                <% [["length", "At least 8 characters"], ["uppercase", "One uppercase letter"], ["lowercase", "One lowercase letter"], ["digit", "One digit"]].each do |target, label| %>
                  <li data-password-strength-target="<%= target %>"><span class="text-gray-400" data-password-strength-target="<%= target %>Icon">○</span> <%= label %></li>
                <% end %>
              </ul>
            </div>
          </div>
          <div class="tf-field"><%= f.label :password_confirmation, "Confirm new password" %><%= f.password_field :password_confirmation, autocomplete: "new-password" %></div>
        </fieldset>
        <fieldset>
          <legend>Confirm your changes</legend>
          <div class="tf-field"><%= f.label :current_password %><%= f.password_field :current_password, autocomplete: "current-password", aria: { describedby: "current-password-help" } %><p id="current-password-help">Enter your current password to save any changes.</p></div>
        </fieldset>
        <div class="tf-form-actions"><%= link_to "Cancel", dashboard_path, class: "tf-text-link" %><%= f.submit "Save changes", class: "tf-button tf-button-primary" %></div>
      <% end %>
    </div>
    <section class="tf-danger-zone" aria-labelledby="delete-account-heading">
      <h2 id="delete-account-heading">Delete account</h2>
      <p>This permanently removes your account and all its data. This action cannot be undone.</p>
      <%= button_to "Delete my account", registration_path(resource_name), method: :delete, data: { turbo_confirm: "Are you sure you want to delete your account? This cannot be undone." }, class: "tf-button tf-button-outline" %>
    </section>
  </div>
</div>
