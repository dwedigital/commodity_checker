<div class="tf-signin">
  <div class="tf-signin-card">
    <p class="tf-eyebrow">TARIFFIK ACCOUNT</p>
    <h1>Create your account</h1>
    <p class="tf-signin-lead">Five free lookups a month, no card needed.</p>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/google_button", label: "Continue with Google" %>

    <p class="tf-signin-divider"><span>or sign up with an email address</span></p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "tf-auth-form" }) do |f| %>
      <div class="tf-field">
        <%= f.label :email, "Email address" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
        <p>We will send you a link to confirm it before your account opens.</p>
      </div>

      <div class="tf-field" data-controller="password-strength">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "new-password", required: true,
                             data: { password_strength_target: "input", action: "input->password-strength#validate" } %>
        <div class="tf-password-guidance">
          <p>Your password needs:</p>
          <ul>
            <% [ [ "length", "At least 8 characters" ], [ "uppercase", "One uppercase letter" ], [ "lowercase", "One lowercase letter" ], [ "digit", "One digit" ] ].each do |target, label| %>
              <li data-password-strength-target="<%= target %>"><span data-password-strength-target="<%= target %>Icon">○</span> <%= label %></li>
            <% end %>
          </ul>
        </div>
      </div>

      <div class="tf-field">
        <%= f.label :password_confirmation, "Confirm password" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
      </div>

      <%= f.submit "Create account", class: "tf-button tf-button-primary tf-button-block" %>
    <% end %>

    <p class="tf-signin-note">
      Already have an account? <%= link_to "Sign in", new_session_path(resource_name), class: "tf-text-link" %>.
    </p>

    <p class="tf-signin-legal">
      By creating an account you agree to our
      <%= link_to "terms", terms_path, class: "tf-text-link" %> and
      <%= link_to "privacy policy", privacy_path, class: "tf-text-link" %>.
    </p>
  </div>
</div>
