<p style="<%= email_eyebrow_style %>">PASSWORD RESET</p>
<h1 style="<%= email_heading_style %>">Choose a new password</h1>

<p style="<%= email_text_style %>">Someone asked to reset the Tariffik password for <strong><%= @resource.email %></strong>.</p>

<p style="margin:22px 0 24px;"><%= email_button "Choose a new password", edit_password_url(@resource, reset_password_token: @token) %></p>

<hr style="<%= email_rule_style %>">

<p style="<%= email_muted_style %>">If the button does not work, paste this into your browser:<br>
<a href="<%= edit_password_url(@resource, reset_password_token: @token) %>" style="<%= email_link_style %>"><%= edit_password_url(@resource, reset_password_token: @token) %></a></p>

<p style="<%= email_muted_style %>">Your password stays as it is until you follow that link. If this was not you, you can ignore this email.</p>
