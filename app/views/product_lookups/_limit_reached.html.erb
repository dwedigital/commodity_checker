<div id="lookup_form" class="tf-limit" role="status">
  <p class="tf-eyebrow">MONTHLY LIMIT REACHED</p>
  <h2>You’ve used this month’s free lookups.</h2>
  <p>
    You’ve used all <%= User::FREE_MONTHLY_LOOKUP_LIMIT %> free lookups. Your limit resets on
    <strong><%= Time.current.next_month.beginning_of_month.strftime("%-d %B") %></strong>.
  </p>
  <%= link_to safe_join([ "Upgrade for unlimited ", tf_arrow ]), root_path(anchor: "pricing"), class: "tf-button tf-button-primary" %>
  <%= link_to "View history", product_lookups_path, class: "tf-text-link" %>
</div>
