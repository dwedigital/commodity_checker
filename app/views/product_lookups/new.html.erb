<div class="tf-narrow">
  <%= render "shared/page_header", eyebrow: "NEW LOOKUP", title: "Find a commodity code", description: "A product link or a photo is all you need to get started." %>

  <% if !user_signed_in? %>
    <p class="tf-allowance-bar">
      <span>Quick lookup — results aren’t saved.</span>
      <%= link_to "Sign in to save lookups", new_user_session_path, class: "tf-text-link" %>
    </p>
  <% elsif current_user.free? && current_user.lookups_remaining > 0 %>
    <%= render "product_lookups/allowance" %>
  <% end %>

  <% if user_signed_in? && !current_user.can_perform_lookup? %>
    <%= render "product_lookups/limit_reached" %>
  <% else %>
    <div id="lookup_form" data-controller="tabs" data-tabs-initial-value="<%= user_signed_in? && params[:tab] == 'photo' ? 'photo' : 'url' %>">
      <div class="tf-panel">
        <div class="tf-tabs" role="tablist" aria-label="Lookup method">
          <button type="button" role="tab" aria-selected="true" data-tabs-target="tab" data-tab="url" data-action="click->tabs#switch">Product link</button>
          <% if user_signed_in? %>
            <button type="button" role="tab" aria-selected="false" data-tabs-target="tab" data-tab="photo" data-action="click->tabs#switch">Photo <span class="tf-badge tf-badge-neutral">Beta</span></button>
          <% else %>
            <%= link_to new_user_session_path do %>Photo <span class="tf-badge tf-badge-muted">Sign in to use</span><% end %>
          <% end %>
        </div>

        <div class="tf-tab-panel" role="tabpanel" data-tabs-target="content" data-tab="url" data-controller="lookup-progress">
          <%= form_with model: @product_lookup, url: product_lookups_path, method: :post, data: { action: "submit->lookup-progress#submit" } do |f| %>
            <% if @product_lookup.errors.any? %>
              <div class="tf-result-notice" role="alert">
                <p class="tf-eyebrow">CHECK THE LINK</p>
                <ul>
                  <% @product_lookup.errors.full_messages.each do |error| %>
                    <li><%= error %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%= f.label :url, "Link to the product page", class: "tf-field-label" %>
            <div class="tf-input-row">
              <%= f.url_field :url, class: "tf-url", placeholder: "https://shop.com/your-product", autocomplete: "url", autofocus: true, aria: { describedby: "lookup-help" } %>
              <button type="submit" data-lookup-progress-target="button" class="tf-button tf-button-primary">
                <span data-lookup-progress-target="buttonText">Find my code</span>
                <svg data-lookup-progress-target="spinner" class="hidden animate-spin size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity=".3"/><path d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="3"/></svg>
                <%= tf_arrow %>
              </button>
            </div>
            <p class="tf-lookup-help" id="lookup-help">Paste the full link to a product page from any shop.</p>
            <p data-lookup-progress-target="status" class="hidden tf-lookup-status" aria-live="polite"></p>
          <% end %>
        </div>

        <% if user_signed_in? %>
          <div class="tf-tab-panel hidden" role="tabpanel" data-tabs-target="content" data-tab="photo">
            <%= render "photo_form" %>
          </div>
        <% end %>
      </div>

      <aside class="tf-note" data-tabs-target="info" data-tab="url">
        <p class="tf-eyebrow">WORKS WITH MOST SHOPS</p>
        <p>Amazon, eBay, ASOS, John Lewis, Argos, Currys, Etsy, AliExpress, Wayfair, and most other shops with product pages.</p>
        <p>We’ll read the product details and suggest the UK commodity code for your customs declaration.</p>
      </aside>

      <% if user_signed_in? %>
        <aside class="tf-note hidden" data-tabs-target="info" data-tab="photo">
          <p class="tf-eyebrow">PHOTO LOOKUP · BETA</p>
          <ul class="tf-check-list">
            <li>Take a clear, well-lit photo of the product</li>
            <li>Include any visible labels, brand names, or tags</li>
            <li>Photograph the whole product, not just a detail</li>
          </ul>
          <p>We’ll identify the product from the image and suggest a commodity code.</p>
        </aside>
      <% end %>
    </div>
  <% end %>
</div>
