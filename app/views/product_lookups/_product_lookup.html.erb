<%# Root carries the id so Turbo broadcasts (ScrapeProductPageJob, AnalyzeProductImageJob) can replace it repeatedly. %>
<div id="product_lookup_<%= product_lookup.id %>">
  <% if product_lookup.pending? %>
    <section class="tf-panel tf-processing"
             data-controller="processing-status"
             data-processing-status-photo-value="<%= product_lookup.photo? %>">
      <span class="tf-spinner" aria-hidden="true"></span>
      <h3 data-processing-status-target="message" aria-live="polite">
        <%= product_lookup.photo? ? "Analyzing product image..." : "Fetching product page..." %>
      </h3>
      <p data-processing-status-target="submessage">This may take a few seconds</p>
    </section>
  <% else %>
    <div class="tf-detail-grid">
      <div>
        <% if product_lookup.failed? && product_lookup.scrape_error.present? %>
          <div class="tf-result-notice" role="alert">
            <p class="tf-eyebrow">WE COULDN’T READ THAT PAGE</p>
            <p><strong>Could not fetch product details</strong></p>
            <p><%= product_lookup.scrape_error %></p>
          </div>
        <% elsif product_lookup.partial? %>
          <div class="tf-result-notice is-warning" role="status">
            <p class="tf-eyebrow">LIMITED DATA</p>
            <p>Some product details couldn’t be retrieved. The site may require JavaScript or have blocked access, so check the code carefully.</p>
          </div>
        <% end %>

        <section class="tf-panel">
          <div class="tf-panel-heading">
            <div>
              <p class="tf-eyebrow">COMMODITY CODE</p>
              <h2><%= product_lookup.commodity_code_confirmed? ? "Confirmed code" : product_lookup.suggested_commodity_code.present? ? "Suggested code" : "No code yet" %></h2>
            </div>
            <% if product_lookup.commodity_code_confirmed? %>
              <span class="tf-badge tf-badge-success">✓ Confirmed</span>
            <% end %>
          </div>
          <div class="tf-panel-body tf-code-body">
            <% if (code = product_lookup.display_commodity_code).present? %>
              <p class="tf-code" aria-hidden="true"><%= commodity_code_display(code) %></p>
              <div class="tf-result-meta">
                <span>Code <strong><%= code %></strong></span>
                <% if !product_lookup.commodity_code_confirmed? && product_lookup.commodity_code_confidence.present? %>
                  <span class="tf-confidence">
                    <span class="tf-confidence-bar"><span style="width: <%= (product_lookup.commodity_code_confidence * 100).clamp(0, 100) %>%"></span></span>
                    <%= number_to_percentage(product_lookup.commodity_code_confidence * 100, precision: 0) %> confidence
                  </span>
                <% end %>
              </div>
              <% if product_lookup.llm_reasoning.present? %>
                <p class="tf-result-reasoning"><%= product_lookup.llm_reasoning %></p>
              <% end %>
              <% unless product_lookup.commodity_code_confirmed? %>
                <%= button_to "Confirm this code", confirm_commodity_code_product_lookup_path(product_lookup, commodity_code: product_lookup.suggested_commodity_code), method: :post, class: "tf-button tf-button-dark" %>
              <% end %>
            <% else %>
              <p class="tf-code-empty"><strong>No suggestion available</strong> We couldn’t determine a commodity code for this product. Try a different product link or a photo.</p>
            <% end %>
          </div>
        </section>

        <section class="tf-panel">
          <div class="tf-panel-heading">
            <div>
              <p class="tf-eyebrow"><%= product_lookup.photo? ? "FROM YOUR PHOTO" : "FROM THE PRODUCT PAGE" %></p>
              <h2>Product details</h2>
            </div>
            <% if product_lookup.photo? %>
              <span class="tf-badge tf-badge-neutral">Photo · beta</span>
            <% end %>
          </div>
          <div class="tf-panel-body">
            <div class="tf-product-summary">
              <% if product_lookup.photo? && product_lookup.product_image.attached? %>
                <%= image_tag product_lookup.product_image.variant(resize_to_limit: [ 200, 200 ]), alt: product_lookup.title || "Product photo" %>
              <% elsif product_lookup.image_url.present? %>
                <img src="<%= product_lookup.image_url %>" alt="<%= product_lookup.title %>">
              <% end %>
              <dl class="tf-detail-list">
                <% { "Title" => product_lookup.title, "Brand" => product_lookup.brand, "Category" => product_lookup.category, "Material" => product_lookup.material }.each do |label, value| %>
                  <% next if value.blank? %>
                  <div><dt><%= label %></dt><dd><%= value %></dd></div>
                <% end %>
                <% if product_lookup.price.present? %>
                  <div><dt>Price</dt><dd><%= { "GBP" => "£", "EUR" => "€" }.fetch(product_lookup.currency, "$") %><%= product_lookup.price %></dd></div>
                <% end %>
                <% if product_lookup.description.present? %>
                  <div><dt>Description</dt><dd><%= truncate(product_lookup.description, length: 500) %></dd></div>
                <% end %>
              </dl>
            </div>
            <% if product_lookup.url? && product_lookup.url.present? %>
              <div class="tf-panel-footer">
                <a href="<%= product_lookup.url %>" target="_blank" rel="noopener" class="tf-text-link">View original product page&nbsp;<%= tf_arrow %></a>
              </div>
            <% end %>
          </div>
        </section>
      </div>

      <div>
        <section class="tf-panel">
          <div class="tf-panel-heading">
            <div>
              <p class="tf-eyebrow">KEEP IT TOGETHER</p>
              <h2><%= product_lookup.order_item.present? ? "In an order" : "Add to an order" %></h2>
            </div>
          </div>
          <% if product_lookup.order_item.present? %>
            <% order = product_lookup.order_item.order %>
            <ul class="tf-record-list">
              <li><%= link_to order_path(order) do %><%= tf_arrow(classes: "tf-record-icon") %><div class="tf-record-copy"><strong><%= order.retailer_name.presence || "Order" %></strong><span><%= order.order_reference.presence || "No reference" %></span></div><span class="tf-badge tf-badge-success">Added</span><% end %></li>
            </ul>
          <% else %>
            <% orders = product_lookup.user.orders.order(created_at: :desc).limit(10) %>
            <% if orders.any? %>
              <p class="tf-panel-intro">Choose the order this product belongs to.</p>
              <ul class="tf-order-picker">
                <% orders.each do |order| %>
                  <li>
                    <%= button_to add_to_order_product_lookup_path(product_lookup, order_id: order.id), method: :post do %>
                      <span class="tf-record-icon" aria-hidden="true">+</span>
                      <span><strong><%= order.retailer_name.presence || "Order" %></strong><small><%= order.order_reference.presence || "No reference" %> · <%= order.created_at.strftime("%-d %b") %></small></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <div class="tf-empty-state"><span aria-hidden="true">↳</span><h3>No orders yet.</h3><p>Create an order first, then add this product to it.</p><%= link_to safe_join([ "Add an order ", tf_arrow ]), new_order_path, class: "tf-button tf-button-outline" %></div>
            <% end %>
          <% end %>
        </section>
      </div>
    </div>
  <% end %>
</div>
