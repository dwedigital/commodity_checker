<%= turbo_stream_from "product_lookup_#{@product_lookup.id}" %>

<%= render "shared/page_header",
      breadcrumbs: [ [ "Lookups", product_lookups_path ], [ lookup_type_label(@product_lookup), nil ] ],
      title: truncate(@product_lookup.title.presence || "Product lookup", length: 110),
      description: @product_lookup.retailer_name&.titleize,
      actions: render("product_lookups/status_badge", product_lookup: @product_lookup) %>

<%= render "product_lookup", product_lookup: @product_lookup %>
