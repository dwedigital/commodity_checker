<% content_for(:full_width, true) %>

<div class="tf-wrap tf-page">
  <%= render "shared/page_header", eyebrow: "GUIDES", title: "Commodity codes, explained.", page_title: "Blog — Tariffik", description: "Practical guides to classifying the things you import, from clothing to electronics." %>

  <% if @posts.empty? %>
    <section class="tf-panel">
      <div class="tf-empty-state"><span aria-hidden="true">≡</span><h3>The first guide is on its way.</h3><p>In the meantime, try a lookup and see the reasoning behind a code.</p><%= link_to safe_join([ "Find my code ", tf_arrow ]), root_path(anchor: "lookup"), class: "tf-button tf-button-outline" %></div>
    </section>
  <% else %>
    <ul class="tf-post-list">
      <% @posts.each do |post| %>
        <%= render "post_card", post: post %>
      <% end %>
    </ul>
  <% end %>
</div>
