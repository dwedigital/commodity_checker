<li>
  <%= link_to blog_post_path(post.slug) do %>
    <time datetime="<%= post.date.iso8601 %>"><%= post.date.strftime("%-d %B %Y") %></time>
    <article>
      <h2><%= post.title %></h2>
      <% if post.description.present? %>
        <p><%= post.description %></p>
      <% end %>
      <% if post.tags.any? %>
        <div class="tf-post-tags">
          <% post.tags.first(3).each do |tag| %>
            <span class="tf-badge tf-badge-neutral"><%= tag.tr("-", " ").capitalize %></span>
          <% end %>
        </div>
      <% end %>
    </article>
    <span class="tf-post-read" aria-hidden="true">Read ↗</span>
  <% end %>
</li>
