<%= render "shared/page_header", eyebrow: "YOUR ACCOUNT", title: "Account settings", description: "See how you sign in, set a password, and close your account if you need to." %>

<div class="tf-settings-layout">
  <aside class="tf-settings-aside">
    <%= render "shared/account_avatar", user: @user %>
    <h2>Your Tariffik account</h2>
    <p class="tf-settings-email"><%= @user.email %></p>
    <span class="tf-badge tf-badge-neutral"><%= @user.subscription_tier.titleize %> plan</span>
    <p class="mt-6">Your saved lookups and orders stay with this account.</p>
    <%= link_to "Back to your dashboard →", dashboard_path, class: "tf-text-link" %>
  </aside>

  <div class="tf-settings-main">
    <div class="tf-panel">
      <div class="tf-panel-heading">
        <div>
          <p class="tf-eyebrow">SIGN IN</p>
          <h2>How you sign in</h2>
        </div>
      </div>

      <div class="tf-panel-body">
        <% if @user.google_linked? && @user.password_set? %>
          <p>You can sign in with Google, or with your email address and password.</p>
        <% elsif @user.google_linked? %>
          <p>You sign in with Google. Tariffik never sees or stores a password, and your email address is whatever Google holds for this account.</p>
        <% else %>
          <p>You sign in with your email address and password. Signing in with Google using this same address will connect it too.</p>
        <% end %>

        <dl class="tf-account-facts">
          <div>
            <dt><%= @user.google_linked? ? "Google account" : "Email address" %></dt>
            <dd><%= @user.email %></dd>
          </div>
          <% if @user.name.present? %>
            <div>
              <dt>Name</dt>
              <dd><%= @user.name %></dd>
            </div>
          <% end %>
          <div>
            <dt>Your forwarding address</dt>
            <dd><%= @user.inbound_email_address %></dd>
          </div>
        </dl>

        <% if @user.google_linked? %>
          <p class="tf-account-note">To change the email address on this account, change it with Google, or close this account and sign in with the Google account you want to use.</p>
        <% end %>
      </div>
    </div>

    <div class="tf-panel">
      <div class="tf-panel-heading">
        <div>
          <p class="tf-eyebrow">PASSWORD</p>
          <h2><%= @user.password_set? ? "Change your password" : "Set a password" %></h2>
        </div>
      </div>
      <div class="tf-panel-body">
        <% unless @user.password_set? %>
          <p>You sign in with Google. Setting a password gives you a second way in; Google keeps working either way.</p>
        <% end %>

        <%= render "devise/shared/error_messages", resource: @user %>

        <%= form_with model: @user, url: account_password_path, method: :patch, class: "tf-auth-form" do |f| %>
          <% if @user.password_set? %>
            <div class="tf-field">
              <%= f.label :current_password, "Current password" %>
              <%= f.password_field :current_password, autocomplete: "current-password", required: true %>
            </div>
          <% end %>

          <div class="tf-field" data-controller="password-strength">
            <%= f.label :password, @user.password_set? ? "New password" : "Password" %>
            <%= f.password_field :password, autocomplete: "new-password", required: true,
                                 data: { password_strength_target: "input", action: "input->password-strength#validate" } %>
            <div class="tf-password-guidance">
              <p>Your password needs:</p>
              <ul>
                <% [ [ "length", "At least 8 characters" ], [ "uppercase", "One uppercase letter" ], [ "lowercase", "One lowercase letter" ], [ "digit", "One digit" ] ].each do |target, label| %>
                  <li data-password-strength-target="<%= target %>"><span data-password-strength-target="<%= target %>Icon">○</span> <%= label %></li>
                <% end %>
              </ul>
            </div>
          </div>

          <div class="tf-field">
            <%= f.label :password_confirmation, "Confirm password" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
          </div>

          <%= f.submit @user.password_set? ? "Change password" : "Set password", class: "tf-button tf-button-primary" %>
        <% end %>
      </div>
    </div>

    <div class="tf-panel">
      <div class="tf-panel-heading">
        <div>
          <p class="tf-eyebrow">ACCESS</p>
          <h2>Connected apps</h2>
        </div>
        <%= link_to "Manage →", oauth_authorized_applications_path, class: "tf-text-link" %>
      </div>
      <div class="tf-panel-body">
        <p>AI assistants you have connected to Tariffik over MCP appear here. Disconnect one and it loses access straight away.</p>
      </div>
    </div>

    <section class="tf-danger-zone" aria-labelledby="delete-account-heading">
      <h2 id="delete-account-heading">Delete account</h2>
      <p>This permanently removes your account and all its data. This action cannot be undone.</p>
      <%= button_to "Delete my account", account_path, method: :delete, data: { turbo_confirm: "Are you sure you want to delete your account? This cannot be undone." }, class: "tf-button tf-button-outline" %>
    </section>
  </div>
</div>
