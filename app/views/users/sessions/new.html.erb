<div class="tf-signin">
  <div class="tf-signin-card">
    <% if @connecting_extension %>
      <p class="tf-eyebrow">BROWSER EXTENSION</p>
      <h1>Sign in to connect the extension</h1>
      <p class="tf-signin-lead">Once you are in, we will ask you to connect the extension to this account.</p>
    <% else %>
      <p class="tf-eyebrow">TARIFFIK ACCOUNT</p>
      <h1>Sign in to Tariffik</h1>
    <% end %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/google_button", label: "Continue with Google" %>

    <p class="tf-signin-divider"><span>or use your email address</span></p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "tf-auth-form" }) do |f| %>
      <div class="tf-field">
        <%= f.label :email, "Email address" %>
        <%= f.email_field :email, autocomplete: "email", required: true %>
      </div>

      <div class="tf-field">
        <%= f.label :password %>
        <%= f.password_field :password, autocomplete: "current-password", required: true %>
      </div>

      <div class="tf-auth-form-row">
        <span class="tf-checkbox">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "Stay signed in" %>
        </span>
        <%= link_to "Forgot your password?", new_password_path(resource_name), class: "tf-text-link" %>
      </div>

      <%= f.submit "Sign in", class: "tf-button tf-button-primary tf-button-block" %>
    <% end %>

    <p class="tf-signin-note">
      New to Tariffik? <%= link_to "Create an account", new_registration_path(resource_name), class: "tf-text-link" %>.
    </p>

    <p class="tf-signin-legal">
      By continuing you agree to our
      <%= link_to "terms", terms_path, class: "tf-text-link" %> and
      <%= link_to "privacy policy", privacy_path, class: "tf-text-link" %>.
    </p>
  </div>
</div>
