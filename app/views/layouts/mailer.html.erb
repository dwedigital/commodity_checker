<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light only">
    <meta name="supported-color-schemes" content="light only">
    <title>Tariffik</title>
  </head>
  <body style="margin:0; padding:0; width:100%; background-color:<%= MailerHelper::PAPER %>; -webkit-font-smoothing:antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= MailerHelper::PAPER %>;">
      <tr>
        <td align="center" style="padding:36px 16px 44px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px; margin:0 auto;">

            <tr>
              <td style="padding:0 2px 18px; font-family:<%= MailerHelper::FONT %>; font-size:21px; font-weight:600; letter-spacing:-0.8px; color:<%= MailerHelper::INK %>;">
                tariffik<span style="color:<%= MailerHelper::RED %>;">.</span>
              </td>
            </tr>

            <tr>
              <td style="background-color:<%= MailerHelper::CARD %>; border:1px solid <%= MailerHelper::LINE %>; border-radius:9px; padding:34px 32px;">
                <%= yield %>
              </td>
            </tr>

            <tr>
              <td style="padding:20px 2px 0; font-family:<%= MailerHelper::FONT %>; font-size:12px; line-height:1.7; color:<%= MailerHelper::MUTED %>;">
                Tariffik finds the UK and EU commodity code for what you are importing.<br>
                <a href="https://tariffik.com" style="color:<%= MailerHelper::MUTED %>; text-decoration:underline;">tariffik.com</a>
                &nbsp;·&nbsp; Made in Jersey. For things from everywhere.
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
