<%= turbo_frame_tag "lookup_result" do %>
  <div class="tf-result">
    <% if @error.present? %>
      <div class="tf-result-notice" role="alert">
        <p class="tf-eyebrow"><%= @limit_reached ? "FREE LOOKUPS USED" : "CHECK THE LINK" %></p>
        <p><%= @error %></p>
        <% if @limit_reached %>
          <%= link_to "Create free account ↗", new_user_session_path(source: "lookup_result"), class: "tf-button tf-button-primary" %>
        <% end %>
      </div>

    <% elsif @scrape_result && @scrape_result[:status] == :failed %>
      <div class="tf-result-notice" role="alert">
        <p class="tf-eyebrow">WE COULDN’T READ THAT PAGE</p>
        <p><strong>Could not fetch product details</strong></p>
        <p><%= @scrape_result[:error] %></p>
      </div>

    <% elsif @scrape_result %>
      <article class="tf-result-card">
        <div class="tf-sample-top">
          <span class="tf-eyebrow">YOUR RESULT</span>
          <% if @suggestion && @suggestion[:commodity_code].present? %>
            <span class="tf-status">✓ Suggested code</span>
          <% end %>
        </div>

        <div class="tf-sample-product tf-result-product">
          <% if @scrape_result[:image_url].present? %>
            <img src="<%= @scrape_result[:image_url] %>" alt="">
          <% end %>
          <div>
            <% if @scrape_result[:title].present? %>
              <h3><%= @scrape_result[:title] %></h3>
            <% end %>
            <% if @scrape_result[:brand].present? || @scrape_result[:retailer_name].present? %>
              <p><%= [ @scrape_result[:brand], @scrape_result[:retailer_name]&.titleize ].compact.join(" · ") %></p>
            <% end %>
          </div>
        </div>

        <% if @suggestion && @suggestion[:commodity_code].present? %>
          <p class="tf-code" aria-hidden="true"><%= commodity_code_display(@suggestion[:commodity_code]) %></p>
          <div class="tf-result-meta">
            <span>Code <strong><%= @suggestion[:commodity_code] %></strong></span>
            <% if @suggestion[:confidence].present? %>
              <span class="tf-confidence">
                <span class="tf-confidence-bar"><span style="width: <%= (@suggestion[:confidence] * 100).clamp(0, 100) %>%"></span></span>
                <%= number_to_percentage(@suggestion[:confidence] * 100, precision: 0) %> confidence
              </span>
            <% end %>
          </div>
          <% if @suggestion[:reasoning].present? %>
            <p class="tf-result-reasoning"><%= @suggestion[:reasoning] %></p>
          <% end %>
        <% else %>
          <div class="tf-result-reasoning">
            <p><strong>Could not determine commodity code</strong></p>
            <p>Try a different product link, or check the product page has a clear title and description.</p>
          </div>
        <% end %>

        <% unless user_signed_in? %>
          <div class="tf-result-cta">
            <p><strong>Save your lookups</strong> Sign up to save products and track orders.</p>
            <%= link_to "Sign up free ↗", new_user_session_path(source: "lookup_result_limit"), class: "tf-button tf-button-primary" %>
          </div>
        <% end %>
      </article>

      <a href="<%= @scrape_result[:url] %>" target="_blank" rel="noopener" class="tf-text-link tf-result-link">View original product ↗</a>
    <% end %>
  </div>
<% end %>
