<% content_for(:title, "Extension connected — Tariffik") %>

<div class="tf-consent">
  <header class="tf-consent-header">
    <div class="tf-consent-mark" aria-hidden="true"><span class="tf-logo-mark">↗</span> ✓ <span>⧉</span></div>
    <h1>Extension connected</h1>
    <p>The Tariffik extension can now use your account.</p>
  </header>

  <section class="tf-panel">
    <div class="tf-panel-body">
      <% if @auth_code.present? %>
        <p class="tf-eyebrow">ONE MORE STEP</p>
        <p class="tf-code-empty">If the extension didn’t pick this up automatically, copy this code and paste it into the extension.</p>
        <div data-controller="clipboard" class="tf-forward-copy">
          <button type="button" data-action="clipboard#copy" aria-label="Copy your connection code"><code data-clipboard-target="source" aria-live="polite"><%= @auth_code %></code><span aria-hidden="true">Copy ↗</span></button>
        </div>
      <% elsif @code.present? %>
        <p class="tf-eyebrow">ALL SET</p>
        <p class="tf-code-empty">The extension should receive your connection automatically. You can close this tab and return to it.</p>
      <% else %>
        <p class="tf-eyebrow">ALL SET</p>
        <p class="tf-code-empty">You can close this tab and return to the extension.</p>
      <% end %>

      <div class="tf-consent-actions">
        <%= link_to "Return to Tariffik ↗", user_signed_in? ? dashboard_path : root_path, class: "tf-button tf-button-dark" %>
      </div>
    </div>
  </section>
</div>
