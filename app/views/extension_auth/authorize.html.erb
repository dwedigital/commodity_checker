<% content_for(:title, "Connect the extension — Tariffik") %>

<div class="tf-consent">
  <header class="tf-consent-header">
    <div class="tf-consent-mark" aria-hidden="true"><span class="tf-logo-mark"></span> ··· <span>⧉</span></div>
    <h1>Connect the Tariffik extension</h1>
    <p>The browser extension is asking to connect to this Tariffik account.</p>
  </header>

  <section class="tf-panel">
    <div class="tf-panel-body">
      <p class="tf-eyebrow">IT WILL BE ABLE TO</p>
      <ul class="tf-check-list">
        <li>Look up commodity codes for products you’re viewing</li>
        <li>Save lookups to your Tariffik account</li>
        <li>See how many lookups your plan has left</li>
      </ul>

      <div class="tf-consent-account">
        <%= render "shared/account_avatar", user: current_user %>
        <div>
          <strong><%= current_user.display_name %></strong>
          <span><%= current_user.email %></span>
          <span>
            <%= current_user.subscription_tier.to_s.humanize %> plan ·
            <% if current_user.extension_lookups_remaining %>
              <%= pluralize(current_user.extension_lookups_remaining, "lookup") %> left this month
            <% else %>
              unlimited lookups
            <% end %>
          </span>
        </div>
      </div>

      <div class="tf-consent-actions">
        <%= link_to "Cancel", root_path, class: "tf-button tf-button-outline" %>
        <%= form_with url: extension_auth_create_path, method: :post do |f| %>
          <%= f.hidden_field :extension_id, value: @extension_id %>
          <%= f.hidden_field :redirect_uri, value: @redirect_uri %>
          <%= f.button type: "submit", class: "tf-button tf-button-primary" do %>Connect extension&nbsp;<%= tf_arrow %><% end %>
        <% end %>
      </div>
    </div>
  </section>

  <p class="tf-consent-footnote">You can disconnect the extension at any time from the <%= link_to "API page", developer_path %>.</p>
</div>
