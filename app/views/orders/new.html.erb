<div class="tf-narrow">
  <%= render "shared/page_header", eyebrow: "YOUR PARCELS", title: "Add an order", description: "Enter the order details and the products you’re importing." %>

  <section class="tf-panel">
    <%= form_with model: @order, class: "tf-settings-form" do |f| %>
      <% if @order.errors.any? %>
        <div class="tf-result-notice" role="alert">
          <p class="tf-eyebrow">CHECK THE DETAILS</p>
          <ul>
            <% @order.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <fieldset>
        <legend>Order details</legend>
        <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">
          <div class="tf-field">
            <%= f.label :retailer_name, "Shop" %>
            <%= f.text_field :retailer_name, placeholder: "e.g. Amazon, eBay" %>
          </div>
          <div class="tf-field">
            <%= f.label :order_reference, "Order reference" %>
            <%= f.text_field :order_reference, placeholder: "e.g. ABC-123456" %>
          </div>
          <div class="tf-field">
            <%= f.label :estimated_delivery, "Expected delivery" %>
            <%= f.date_field :estimated_delivery %>
          </div>
          <div class="tf-field">
            <%= f.label :status, "Status" %>
            <%= f.select :status, Order.statuses.keys.map { |s| [ s.humanize, s ] }, {}, class: "block w-full border" %>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>Items</legend>
        <div class="grid gap-2">
          <% 3.times do |i| %>
            <input type="text" name="items[]" aria-label="Item <%= i + 1 %> description" class="block w-full border" placeholder="Item description, e.g. wireless Bluetooth headphones">
          <% end %>
        </div>
        <p class="tf-lookup-help">Add up to three items. A clear description helps us suggest the right commodity code.</p>
      </fieldset>

      <div class="tf-form-actions">
        <%= link_to "Cancel", orders_path, class: "tf-text-link" %>
        <%= f.submit "Add order", class: "tf-button tf-button-primary" %>
      </div>
    <% end %>
  </section>
</div>
