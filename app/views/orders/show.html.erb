<%= render "shared/page_header",
      breadcrumbs: [ [ "Orders", orders_path ], [ @order.retailer_name.presence || "Order", nil ] ],
      title: @order.retailer_name.presence || "Unknown retailer",
      description: @order.order_reference.presence || "No reference",
      actions: order_status_badge(@order) %>

<div class="tf-detail-grid">
  <div>
    <section class="tf-panel">
      <div class="tf-panel-heading">
        <div>
          <p class="tf-eyebrow">IN THIS PARCEL</p>
          <h2>Items and codes</h2>
        </div>
      </div>
      <% if @order.order_items.any? %>
        <ul class="tf-item-list">
          <% @order.order_items.each do |item| %>
            <li>
              <div class="tf-item-head">
                <% if item.image_url.present? %>
                  <img src="<%= item.image_url %>" alt="" loading="lazy">
                <% end %>
                <div>
                  <strong><%= item.description %></strong>
                  <% if item.quantity && item.quantity > 1 %>
                    <p>Quantity: <%= item.quantity %></p>
                  <% end %>
                  <% if item.product_url.present? %>
                    <a href="<%= item.product_url %>" target="_blank" rel="noopener" class="tf-text-link">View product page ↗</a>
                  <% end %>
                </div>
              </div>

              <% if item.display_commodity_code.present? %>
                <div class="tf-item-code">
                  <div class="tf-item-code-top">
                    <span class="tf-eyebrow">COMMODITY CODE</span>
                    <% if item.commodity_code_confirmed? %>
                      <span class="tf-badge tf-badge-success">✓ Confirmed</span>
                    <% else %>
                      <span class="tf-badge tf-badge-neutral">Suggested</span>
                    <% end %>
                  </div>
                  <p class="tf-code" aria-hidden="true"><%= commodity_code_display(item.display_commodity_code) %></p>
                  <div class="tf-result-meta">
                    <span>Code <strong><%= item.display_commodity_code %></strong></span>
                    <% if !item.commodity_code_confirmed? && item.commodity_code_confidence.present? %>
                      <span class="tf-confidence">
                        <span class="tf-confidence-bar"><span style="width: <%= (item.commodity_code_confidence * 100).clamp(0, 100) %>%"></span></span>
                        <%= number_to_percentage(item.commodity_code_confidence * 100, precision: 0) %> confidence
                      </span>
                    <% end %>
                  </div>
                  <% if !item.commodity_code_confirmed? && item.llm_reasoning.present? %>
                    <p class="tf-result-reasoning"><%= item.llm_reasoning %></p>
                  <% end %>
                  <% unless item.commodity_code_confirmed? %>
                    <%= button_to "Confirm this code", confirm_commodity_code_order_path(@order, order_item_id: item.id, commodity_code: item.suggested_commodity_code), method: :post, class: "tf-button tf-button-dark" %>
                  <% end %>
                </div>
              <% else %>
                <p class="tf-item-code tf-code-empty">Awaiting classification</p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="tf-empty-state"><span aria-hidden="true">#</span><h3>No items yet.</h3><p>Look up a product, then add it to this order from its lookup page.</p><%= link_to "Find a code ↗", new_product_lookup_path, class: "tf-button tf-button-outline" %></div>
      <% end %>
    </section>
  </div>

  <div>
    <section class="tf-panel">
      <div class="tf-panel-heading">
        <div>
          <p class="tf-eyebrow">ON ITS WAY</p>
          <h2>Delivery</h2>
        </div>
      </div>
      <dl class="tf-panel-body tf-detail-list">
        <% if @order.estimated_delivery.present? %>
          <div><dt>Expected delivery</dt><dd><%= @order.estimated_delivery.strftime("%A, %-d %B %Y") %></dd></div>
        <% end %>
        <div><dt>Added</dt><dd><%= @order.created_at.strftime("%-d %b %Y at %H:%M") %></dd></div>
      </dl>
    </section>

    <% if @order.tracking_events.any? %>
      <section class="tf-panel">
        <div class="tf-panel-heading">
          <div>
            <p class="tf-eyebrow">CARRIER UPDATES</p>
            <h2>Tracking</h2>
          </div>
          <%= button_to "Refresh", refresh_tracking_order_path(@order), method: :post, class: "tf-button tf-button-outline" %>
        </div>
        <ul class="tf-panel-body tf-tracking-list">
          <% @order.tracking_events.order(event_timestamp: :desc).each do |event| %>
            <li>
              <div class="tf-item-code-top">
                <span class="tf-badge tf-badge-muted"><%= event.carrier&.titleize || "Unknown carrier" %></span>
                <% if event.event_timestamp %><span><%= event.event_timestamp.strftime("%-d %b %H:%M") %></span><% end %>
              </div>
              <strong><%= event.status %></strong>
              <% if event.location.present? %><p><%= event.location %></p><% end %>
              <% if event.tracking_url.present? %>
                <a href="<%= event.tracking_url %>" target="_blank" rel="noopener" class="tf-text-link">Track on carrier site ↗</a>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
