<% actions = capture do %>
  <%= link_to "Export CSV ↓", export_orders_path(format: :csv), class: "tf-button tf-button-outline" %>
  <%= link_to "Add order ↗", new_order_path, class: "tf-button tf-button-primary" %>
<% end %>
<%= render "shared/page_header", eyebrow: "YOUR PARCELS", title: "Orders", description: "Keep an eye on deliveries and review the codes for every item.", actions: actions %>
<% if @orders.any? %>
  <p class="tf-scroll-hint">Scroll across to see all columns →</p>
  <div class="tf-panel">
    <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Orders table">
    <table class="min-w-full tf-orders-table">
      <thead class="bg-brand-dark">
        <tr>
          <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-white sm:pl-6">Order</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Items</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Status</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Expected</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-white">Codes</th>
          <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
            <span class="sr-only">View</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% @orders.each do |order| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
              <div class="font-semibold text-brand-dark"><%= order.retailer_name || "Unknown retailer" %></div>
              <div class="text-gray-500"><%= order.order_reference || "No reference" %></div>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-600">
              <%= pluralize(order.order_items.count, "item") %>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm">
              <%= order_status_badge(order) %>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-600">
              <%= order.estimated_delivery&.strftime("%d %b %Y") || "–" %>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm">
              <% confirmed = order.order_items.count(&:commodity_code_confirmed?) %>
              <% total = order.order_items.count %>
              <% if confirmed == total && total > 0 %>
                <span class="tf-badge tf-badge-success">All confirmed</span>
              <% elsif confirmed > 0 %>
                <span class="tf-badge tf-badge-neutral"><%= confirmed %> of <%= total %> confirmed</span>
              <% elsif total > 0 %>
                <span class="tf-badge tf-badge-muted">To review</span>
              <% else %>
                <span class="text-gray-400">–</span>
              <% end %>
            </td>
            <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
              <%= link_to "View", order, class: "tf-text-link" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
<% else %>
  <section class="tf-panel">
    <div class="tf-empty-state">
      <span aria-hidden="true">↳</span>
      <h3>Your first order starts here.</h3>
      <p>Forward an order confirmation or tracking email to your personal address and it’ll appear here.</p>
      <div data-controller="clipboard" class="tf-forward-copy">
        <button type="button" data-action="clipboard#copy" aria-label="Copy your forwarding email address"><code data-clipboard-target="source" aria-live="polite"><%= current_user.inbound_email_address %></code><span aria-hidden="true">Copy ↗</span></button>
      </div>
      <%= link_to "Or add an order manually ↗", new_order_path, class: "tf-button tf-button-outline" %>
    </div>
  </section>
<% end %>
