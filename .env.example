# Tariffik Environment Variables
# ================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For local development: dotenv-rails auto-loads this
# For Kamal deployment: source .env && kamal deploy -d production

# =============================================================================
# AUTHENTICATION (required)
# =============================================================================
# Sign in with Google is the only way into the app, so without these nobody can
# sign in. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add these redirect URIs:
#   http://localhost:3101/users/auth/google_oauth2/callback   (local)
#   https://tariffik.com/users/auth/google_oauth2/callback    (production)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# =============================================================================
# AI SERVICES
# =============================================================================
# Anthropic Claude API (required - commodity code suggestions)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Tavily API (optional - AI web search for product details)
TAVILY_API_KEY=tvly-your-key-here

# =============================================================================
# EMAIL (RESEND)
# =============================================================================
RESEND_API_KEY=re_your-key-here
RESEND_WEBHOOK_SECRET=whsec_your-secret-here
INBOUND_EMAIL_DOMAIN=inbound.tariffik.com

# =============================================================================
# CLOUDFLARE R2 STORAGE
# =============================================================================
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key

# =============================================================================
# WEB SCRAPING (OPTIONAL)
# =============================================================================
SCRAPE_DO_API_TOKEN=your-token-here

# TypeSafe AI (Jev decision model) - when set, Jev is the default tree chooser (Claude otherwise)
TYPESAFE_API_KEY=
